+    base::AutoLock lock(channel_lock_);
+    if (!channel_) return;
+  }
+  ObserveMachPortProvider();
+  const bool has_mach_ports = MessageHasMachPorts(*message);
+  const bool broker = GetConfiguration().is_broker_process;
+  base::apple::ScopedMachSendRight child_task;
+  if (has_mach_ports && broker) {
+    if (!mach_port_provider_ || !HasRemoteProcessHandle()) {
+      OnChannelError(Channel::Error::kDisconnected);
+      return;
+    }
+    child_task = mach_port_provider_->RetainTaskForHandle(CloneRemoteProcessHandle().Handle());
+  }
+  if (!pending_mach_writes_.empty() || (has_mach_ports && broker && !child_task.is_valid())) {
+    pending_mach_writes_.push(std::move(message));
+    return;
