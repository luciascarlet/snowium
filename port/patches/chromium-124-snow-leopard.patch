+      if (in_transit.handle().is_fd()) continue;
+      if (!in_transit.handle().is_mach_send()) {
+        LOG(ERROR) << "Snowium unsupported relay handle type="
+                   << static_cast<int>(in_transit.handle().type());
+        valid = false;  // Receive rights are not supported by this relay.
+        break;
+      }
+      auto handle = in_transit.TakeHandle();
+      mach_port_name_t name;
