+#if defined(SNOW_LEOPARD_PORT)
+// static
+void NodeChannel::SetMachPortProvider(base::PortProvider* provider) {
+  CHECK(provider);
+  g_mach_port_provider.store(provider, std::memory_order_release);
+}
+
+// static
+bool NodeChannel::MessageHasMachPorts(const Channel::Message& message) {
+  if (!message.num_handles()) return false;
+  const auto* header = static_cast<const Channel::Message::MachPortsExtraHeader*>(
+      message.extra_header());
+  for (size_t i = 0; i < header->num_ports; ++i) {
+    if (static_cast<PlatformHandle::Type>(header->entries[i].type) !=
+        PlatformHandle::Type::kFd) return true;
+  }
+  return false;
+}
+
+void NodeChannel::ObserveMachPortProvider() {
+  DCHECK(owning_task_runner()->RunsTasksInCurrentSequence());
+  if (!mach_port_provider_) {
+    mach_port_provider_ = g_mach_port_provider.load(std::memory_order_acquire);
+    if (mach_port_provider_) mach_port_provider_->AddObserver(this);
+  }
+}
+
+void NodeChannel::OnReceivedTaskPort(base::ProcessHandle process_handle) {
+  DCHECK(owning_task_runner()->RunsTasksInCurrentSequence());
+  if (CloneRemoteProcessHandle().Handle() != process_handle) return;
+  PendingMessageQueue writes;
+  std::swap(writes, pending_mach_writes_);
+  while (!writes.empty()) {
+    WriteChannelMessage(std::move(writes.front()));
+    writes.pop();
+  }
+  base::queue<PendingMachMessage> reads;
+  std::swap(reads, pending_mach_reads_);
+  while (!reads.empty()) {
+    auto message = std::move(reads.front());
+    reads.pop();
+    OnChannelMessage(message.payload.data(), message.payload.size(),
+                     std::move(message.handles));
+  }
+}
