 gfx::Rect ScrollbarThemeMac::TrackRect(const Scrollbar& scrollbar) {
+#if defined(SNOW_LEOPARD_PORT)
+  if (UsesAquaGeometry(scrollbar)) {
+    // Expose HITheme's knob travel to compositor-side dragging as well.
+    const gfx::Rect first = AquaThumbRect(scrollbar, 0);
+    const gfx::Rect last = AquaThumbRect(scrollbar, scrollbar.Maximum());
+    if (!first.IsEmpty() && !last.IsEmpty()) {
+      gfx::Rect rect = scrollbar.FrameRect();
+      if (scrollbar.Orientation() == kHorizontalScrollbar) {
+        rect.set_x(rect.x() + first.x());
+        rect.set_width(last.right() - first.x());
+      } else {
+        rect.set_y(rect.y() + first.y());
+        rect.set_height(last.bottom() - first.y());
+      }
+      return rect;
+    }
+  }
+  if (HasButtons(scrollbar)) {
+    gfx::Rect rect = scrollbar.FrameRect();
+    int buttons = (scrollbar.CSSScrollbarWidth() == EScrollbarWidth::kThin ? 24 : 30) * scrollbar.ScaleFromDIP();
+    if (scrollbar.Orientation() == kHorizontalScrollbar) rect.set_width(rect.width() - buttons);
+    else rect.set_height(rect.height() - buttons);
+    return rect;
+  }
+#endif
   return scrollbar.FrameRect();
 }
 
