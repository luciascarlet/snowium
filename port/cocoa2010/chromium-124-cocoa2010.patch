 gfx::Rect ScrollbarThemeMac::BackButtonRect(const Scrollbar& scrollbar) {
+#if defined(SNOW_LEOPARD_PORT)
+  if (HasButtons(scrollbar)) {
+    int inner = (scrollbar.CSSScrollbarWidth() == EScrollbarWidth::kThin ? 10 : 14) * scrollbar.ScaleFromDIP();
