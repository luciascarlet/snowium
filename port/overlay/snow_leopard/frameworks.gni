# Snow Leopard exposes these libraries through the ApplicationServices umbrella.
snowium_coretext_framework = "CoreText.framework"
snowium_coregraphics_framework = "CoreGraphics.framework"
if (is_mac) {
  import("//build/config/mac/mac_sdk.gni")
  if (current_cpu == "x64" && mac_deployment_target == "10.6") {
    snowium_coretext_framework = "ApplicationServices.framework"
    snowium_coregraphics_framework = "ApplicationServices.framework"
  }
}
